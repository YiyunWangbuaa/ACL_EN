# 复制为 .env 后填写。不要把 .env 提交到仓库。
# 申请密钥：https://platform.deepseek.com/api_keys
# 调用说明：https://api-docs.deepseek.com/zh-cn/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# enabled 为官方默认思考模式，此时 temperature 不生效。
# disabled 时才会使用脚本里的 temperature=0。
DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high

# 对照模型。密钥只放在 .env，不要写进示例文件。
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 千问直连阿里云百炼的 OpenAI 兼容接口。密钥只放在 .env。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_FLASH=qwen3.8-flash
QWEN_MODEL_27B=qwen3.8-27b
# QWEN_MODEL_2T4 已停用。
# Kimi 使用上面的 QWEN_API_KEY 和 QWEN_BASE_URL。
KIMI_MODEL_K3=kimi-k3
KIMI_MODEL_K26=kimi-k2.6
KIMI_MODEL_K25=kimi-k2.5
KIMI_MODEL_K27_CODE=kimi-k2.7-code
